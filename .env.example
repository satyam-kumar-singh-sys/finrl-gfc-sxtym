# ===========================================================================
# ATA paper trading — environment template
# Copy to .env  (never commit .env)  and fill in your Alpaca PAPER credentials.
# ===========================================================================

# --- Alpaca paper trading (required for live runs) -------------------------
# Create keys at https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY=your_paper_key_here
APCA_API_SECRET=your_paper_secret_here
APCA_BASE_URL=https://paper-api.alpaca.markets
APCA_USE_PAPER_TRADING=true

# --- Runner behaviour ------------------------------------------------------
# Skip a rebalance when every position is already within this distance of target
DRIFT_BAND=0.02
# Ignore orders smaller than this notional (USD)
MIN_ORDER_NOTIONAL=25
# Optional: refuse to trade before this date (YYYY-MM-DD), dry runs only
LIVE_START=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
